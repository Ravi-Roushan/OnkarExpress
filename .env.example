# ============================================
# ONKAR EXPRESS - Environment Configuration
# Copy this file to ".env" and fill in your real values
# ============================================

# Server port
PORT=5500

# ---- Admin Login ----
# Used to log into /admin.html dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeThisPassword123

# ---- Email Notifications (Gmail example) ----
# 1. Use a Gmail account
# 2. Enable 2-Step Verification on that Google account
# 3. Create an "App Password" (Google Account > Security > App Passwords)
# 4. Put that app password below (NOT your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password_here

# Where booking notification emails are sent (your business email)
NOTIFY_EMAIL=onkarexpress123@gmail.com

# ---- Razorpay Payment Gateway ----
# Sign up free at https://dashboard.razorpay.com/ (use Test Mode keys first)
# Dashboard > Settings > API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
